# Supabase Configuration
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your_local_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Google OAuth Credentials
# Setup: https://console.cloud.google.com → Create OAuth 2.0 credentials
# Then add to Supabase dashboard: Authentication > Providers > Google
# Read GOOGLE_OAUTH_SETUP.md for detailed instructions
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Gemini AI - used only in Edge Functions
GEMINI_API_KEY=your_gemini_api_key

# Firebase (push notifications only)
FIREBASE_PROJECT_ID=healthos-dev

# Environment
ENVIRONMENT=development
