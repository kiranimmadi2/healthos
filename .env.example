# The Flutter app does not currently load values from a .env file.
#
# Firebase platform configuration is generated in:
#   lib/firebase_options.dart
#
# Native Firebase files are configured separately:
#   android/app/google-services.json
#   ios/Runner/GoogleService-Info.plist
#
# Reference value for a future secure AI gateway. The current AI client does
# not read this variable; see the manual-review notes in ARCHITECTURE.md.
GEMINI_API_KEY=replace_with_server_side_key
